{
  "volume": 3,
  "tier": 1,
  "randomPreset": true,
  "mappings": [
    {
      "name": "welcome",
      "triggers": [
        {
          "type": "event",
          "event": "openpeon.startup"
        }
      ],
      "sounds": [
        "scbw-protoss/templar-rdy00.wav"
      ]
    },
    {
      "name": "acknowledge",
      "triggers": [
        {
          "type": "event",
          "event": "message.updated",
          "role": "user"
        }
      ],
      "sounds": [
        "scbw-protoss/templar-yes00.wav",
        "scbw-protoss/templar-yes01.wav",
        "scbw-protoss/templar-yes02.wav",
        "scbw-protoss/templar-yes03.wav"
      ]
    },
    {
      "name": "work-complete",
      "triggers": [
        {
          "type": "event",
          "event": "session.idle"
        }
      ],
      "sounds": [
        "scbw-protoss/advisor-upd06.wav"
      ]
    },
    {
      "name": "permission-asked",
      "triggers": [
        {
          "type": "event",
          "event": "permission.asked"
        },
        {
          "type": "tool.before",
          "tool": "question"
        }
      ],
      "sounds": [
        "scbw-protoss/templar-wht00.wav",
        "scbw-protoss/templar-wht02.wav"
      ]
    },
    {
      "name": "working-hard",
      "triggers": [
        {
          "type": "tool.before",
          "tool": "todowrite"
        },
        {
          "type": "tool.before",
          "tool": "todoread"
        },
        {
          "type": "tool.before",
          "tool": "read"
        },
        {
          "type": "tool.before",
          "tool": "write"
        },
        {
          "type": "tool.before",
          "tool": "edit"
        },
        {
          "type": "tool.before",
          "tool": "glob"
        },
        {
          "type": "tool.before",
          "tool": "grep"
        },
        {
          "type": "tool.before",
          "tool": "webfetch"
        },
        {
          "type": "tool.before",
          "tool": "bash"
        }
      ],
      "sounds": [
        "scbw-protoss/templar-hal00.wav",
        "scbw-protoss/templar-hal01.wav",
        "scbw-protoss/templar-sto00.wav",
        "scbw-protoss/templar-sto01.wav"
      ],
      "whisper": true
    }
  ]
}