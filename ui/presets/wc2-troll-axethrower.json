{
  "volume": 3,
  "tier": 3,
  "mappings": [
    {
      "name": "welcome",
      "triggers": [
        { "type": "event", "event": "openpeon.startup" }
      ],
      "sounds": [
        "wc2-horde/troll-axethrower-other-ready.wav"
      ]
    },
    {
      "name": "acknowledge",
      "triggers": [
        { "type": "event", "event": "message.updated", "role": "user" }
      ],
      "sounds": [
        "wc2-horde/troll-axethrower-acknowledge-1.wav",
        "wc2-horde/troll-axethrower-acknowledge-2.wav",
        "wc2-horde/troll-axethrower-acknowledge-3.wav"
      ]
    },
    {
      "name": "work-complete",
      "triggers": [
        { "type": "event", "event": "session.idle" }
      ],
      "sounds": [
        "wc2-horde/basic-orc-voices-other-work-complete.wav"
      ]
    },
    {
      "name": "permission-asked",
      "triggers": [
        { "type": "event", "event": "permission.asked" },
        { "type": "tool.before", "tool": "question" }
      ],
      "sounds": [
        "wc2-horde/troll-axethrower-selected-1.wav",
        "wc2-horde/troll-axethrower-selected-2.wav",
        "wc2-horde/troll-axethrower-selected-3.wav"
      ]
    },
    {
      "name": "working-hard",
      "triggers": [
        { "type": "tool.before", "tool": "todowrite" },
        { "type": "tool.before", "tool": "todoread" },
        { "type": "tool.before", "tool": "read" },
        { "type": "tool.before", "tool": "write" },
        { "type": "tool.before", "tool": "edit" },
        { "type": "tool.before", "tool": "glob" },
        { "type": "tool.before", "tool": "grep" },
        { "type": "tool.before", "tool": "bash" }
      ],
      "sounds": [
        "wc2-horde/buildings-other-altar-of-storms.wav",
        "wc2-horde/buildings-other-ogre-mound.wav",
        "wc2-horde/buildings-other-goblin-alchemist.wav"
      ],
      "whisper": true
    }
  ],
  "randomPreset": true
}
