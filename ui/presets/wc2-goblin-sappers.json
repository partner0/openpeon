{
  "volume": 3,
  "tier": 1,
  "randomPreset": true,
  "mappings": [
    {
      "name": "welcome",
      "triggers": [
        {
          "type": "event",
          "event": "openpeon.startup"
        }
      ],
      "sounds": [
        "wc2-horde/goblin-sappers-other-ready.wav"
      ]
    },
    {
      "name": "acknowledge",
      "triggers": [
        {
          "type": "event",
          "event": "message.updated",
          "role": "user"
        }
      ],
      "sounds": [
        "wc2-horde/goblin-sappers-acknowledge-1.wav",
        "wc2-horde/goblin-sappers-acknowledge-2.wav",
        "wc2-horde/goblin-sappers-acknowledge-3.wav",
        "wc2-horde/goblin-sappers-acknowledge-4.wav"
      ]
    },
    {
      "name": "work-complete",
      "triggers": [
        {
          "type": "event",
          "event": "session.idle"
        }
      ],
      "sounds": [
        "wc2-horde/basic-orc-voices-other-work-complete.wav"
      ]
    },
    {
      "name": "permission-asked",
      "triggers": [
        {
          "type": "event",
          "event": "permission.asked"
        },
        {
          "type": "tool.before",
          "tool": "question"
        }
      ],
      "sounds": [
        "wc2-horde/goblin-sappers-selected-1.wav",
        "wc2-horde/goblin-sappers-selected-3.wav"
      ]
    },
    {
      "name": "working-hard",
      "triggers": [
        {
          "type": "tool.before",
          "tool": "todowrite"
        },
        {
          "type": "tool.before",
          "tool": "todoread"
        },
        {
          "type": "tool.before",
          "tool": "read"
        },
        {
          "type": "tool.before",
          "tool": "write"
        },
        {
          "type": "tool.before",
          "tool": "edit"
        },
        {
          "type": "tool.before",
          "tool": "glob"
        },
        {
          "type": "tool.before",
          "tool": "grep"
        },
        {
          "type": "tool.before",
          "tool": "webfetch"
        },
        {
          "type": "tool.before",
          "tool": "bash"
        }
      ],
      "sounds": [
        "wc2-horde/buildings-other-goblin-alchemist.wav",
        "wc2-alliance/buildings-foundry.wav",
        "wc2-alliance/buildings-blacksmith.wav"
      ],
      "whisper": true
    }
  ]
}