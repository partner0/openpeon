{
  "volume": 3,
  "tier": 1,
  "randomPreset": true,
  "mappings": [
    {
      "name": "welcome",
      "triggers": [
        {
          "type": "event",
          "event": "openpeon.startup"
        }
      ],
      "sounds": [
        "sc2-terran/battlecruiser-ready00.mp3"
      ]
    },
    {
      "name": "acknowledge",
      "triggers": [
        {
          "type": "event",
          "event": "message.updated",
          "role": "user"
        }
      ],
      "sounds": [
        "sc2-terran/battlecruiser-yes00.mp3",
        "sc2-terran/battlecruiser-yes01.mp3",
        "sc2-terran/battlecruiser-yes02.mp3",
        "sc2-terran/battlecruiser-yes03.mp3",
        "sc2-terran/battlecruiser-yes04.mp3",
        "sc2-terran/battlecruiser-yes05.mp3",
        "sc2-terran/battlecruiser-yes06.mp3",
        "sc2-terran/battlecruiser-yes07.mp3",
        "sc2-terran/battlecruiser-yes08.mp3",
        "sc2-terran/battlecruiser-yes09.mp3",
        "sc2-terran/battlecruiser-yes10.mp3",
        "sc2-terran/battlecruiser-yes11.mp3",
        "sc2-terran/battlecruiser-yes12.mp3"
      ]
    },
    {
      "name": "work-complete",
      "triggers": [
        {
          "type": "event",
          "event": "session.idle"
        }
      ],
      "sounds": [
        "sc2-terran/scv-jobsfinished00.mp3"
      ]
    },
    {
      "name": "permission-asked",
      "triggers": [
        {
          "type": "event",
          "event": "permission.asked"
        },
        {
          "type": "tool.before",
          "tool": "question"
        }
      ],
      "sounds": [
        "sc2-terran/battlecruiser-what01.mp3",
        "sc2-terran/battlecruiser-what02.mp3",
        "sc2-terran/battlecruiser-what05.mp3"
      ]
    },
    {
      "name": "working-hard",
      "triggers": [
        {
          "type": "tool.before",
          "tool": "todowrite"
        },
        {
          "type": "tool.before",
          "tool": "todoread"
        },
        {
          "type": "tool.before",
          "tool": "read"
        },
        {
          "type": "tool.before",
          "tool": "write"
        },
        {
          "type": "tool.before",
          "tool": "edit"
        },
        {
          "type": "tool.before",
          "tool": "glob"
        },
        {
          "type": "tool.before",
          "tool": "grep"
        },
        {
          "type": "tool.before",
          "tool": "webfetch"
        },
        {
          "type": "tool.before",
          "tool": "bash"
        }
      ],
      "sounds": [
        "sc2-terran/battlecruiser-attack00.mp3",
        "sc2-terran/battlecruiser-attack01.mp3",
        "sc2-terran/battlecruiser-attack02.mp3",
        "sc2-terran/battlecruiser-attack03.mp3",
        "sc2-terran/battlecruiser-attack04.mp3",
        "sc2-terran/battlecruiser-attack05.mp3"
      ],
      "whisper": true
    }
  ]
}