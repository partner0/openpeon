        {
          "type": "event",
          "event": "session.idle"
        }
      ],
      "sounds": [
        "scbw-terran/phoenix-pss00.wav",
        "scbw-terran/phoenix-pss01.wav",
        "scbw-terran/phoenix-pss02.wav",
        "scbw-terran/phoenix-pss03.wav",
        "scbw-terran/phoenix-pss04.wav",
        "scbw-terran/phoenix-pss05.wav",
        "scbw-terran/phoenix-pss06.wav"
